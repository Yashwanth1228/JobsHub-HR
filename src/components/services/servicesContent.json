    {
        "title":  "Background Verification Services",
        "blocks":  [
                       {
                           "type":  "paragraph",
                           "text":  "Ensure Trust. Build Credibility. Hire with Confidence."
                       },
                       {
                           "type":  "paragraph",
                           "text":  "At JOBSHUB HR, we understand that the integrity of your workforce is crucial to your success. Our comprehensive Background Verification Services for hired candidates from us which help you make informed hiring decisions by verifying the credentials, identity, and background of prospective employees."
                       },
                       {
                           "type":  "heading",
                           "text":  "Why Background Verification Matters"
                       },
                       {
                           "type":  "paragraph",
                           "text":  "Hiring the wrong candidate can be costly—not just financially, but in terms of time, reputation, and workplace safety. Our verification process minimizes risks and ensures compliance by confirming:"
                       },
                       {
                           "type":  "list",
                           "inline":  false,
                           "items":  [
                                         {
                                             "text":  "Educational Qualifications: Verification of degrees, certificates, and institutions attended.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  27
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Employment History : Confirmation of previous job roles, tenure, and reasons for leaving.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  20
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Criminal Records Check : Screening for any criminal background across national and local databases.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  24
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Identity Verification : Authentication of identity using official documents like Aadhaar, PAN, Passport, etc.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  23
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Address Verification : Physical and document-based verification of permanent and current address.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  22
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Reference Checks : Professional reference validation from past employers or managers.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  18
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Social Media Screening (Optional) : Assessing public social media presence for potential red flags.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  35
                                                          }
                                                      ]
                                         }
                                     ],
                           "icon":  "circle"
                       },
                       {
                           "type":  "heading",
                           "text":  "Our Process"
                       },
                       {
                           "type":  "list",
                           "inline":  false,
                           "items":  [
                                         {
                                             "text":  "Consent-Based Checks – Fully compliant with legal and ethical standards.",
                                             "bold":  [

                                                      ]
                                         },
                                         {
                                             "text":  "Fast Turnaround – Most verifications completed within 3–7 business days.",
                                             "bold":  [

                                                      ]
                                         },
                                         {
                                             "text":  "Secure \u0026 Confidential – Your data is safe with us, protected by strict confidentiality policies.",
                                             "bold":  [

                                                      ]
                                         },
                                         {
                                             "text":  "Tailored Packages – Customizable to your industry, role type, and company policy.",
                                             "bold":  [

                                                      ]
                                         }
                                     ],
                           "icon":  "check"
                       },
                       {
                           "type":  "heading",
