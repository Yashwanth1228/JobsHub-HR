                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  27
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Scalable Solutions : Need one person or an entire team. We JOBSHUB HR can scale up or down based on your workload and budget.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  18
                                                          }
                                                      ]
                                         },
                                         {
                                             "text":  "Cost-Effective Staffing : Save on recruitment, training, and employee benefits.",
                                             "bold":  [
                                                          {
                                                              "start":  0,
                                                              "end":  23
                                                          }
                                                      ]
